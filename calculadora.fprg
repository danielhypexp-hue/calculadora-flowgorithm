<?xml version="1.0"?>
<flowgorithm fileversion="2.18">
  <attributes>
    <attribute name="name" value="Calculadora - 20 Operacoes"/>
    <attribute name="authors" value="Preencher com o nome do aluno"/>
    <attribute name="about" value="Calculadora com 20 operacoes, incluindo IMC e areas geometricas."/>
    <attribute name="saved" value="2026-10-26 12:00:00"/>
  </attributes>
  <function name="Main" type="None" variable="">
    <parameters/>
    <body><declare name="op" type="Integer" array="False" size=""/><declare name="a" type="Real" array="False" size=""/><declare name="b" type="Real" array="False" size=""/><declare name="c" type="Real" array="False" size=""/><declare name="resultado" type="Real" array="False" size=""/><declare name="peso" type="Real" array="False" size=""/><declare name="altura" type="Real" array="False" size=""/><declare name="base" type="Real" array="False" size=""/><declare name="raio" type="Real" array="False" size=""/><declare name="aresta" type="Real" array="False" size=""/><declare name="capital" type="Real" array="False" size=""/><declare name="taxa" type="Real" array="False" size=""/><declare name="tempo" type="Real" array="False" size=""/><declare name="preco" type="Real" array="False" size=""/><declare name="percentual" type="Real" array="False" size=""/><declare name="distancia" type="Real" array="False" size=""/><declare name="litros" type="Real" array="False" size=""/><declare name="temperatura" type="Real" array="False" size=""/><declare name="n" type="Integer" array="False" size=""/><declare name="f" type="Real" array="False" size=""/><declare name="x" type="Real" array="False" size=""/><output expression="&quot;===== CALCULADORA - 20 OPERACOES =====
1 Soma | 2 Subtracao | 3 Multiplicacao | 4 Divisao
5 Media | 6 Porcentagem | 7 Regra de tres
8 Celsius para Fahrenheit | 9 Fahrenheit para Celsius
10 Perimetro retangulo | 11 Area retangulo | 12 Area triangulo
13 Area circulo | 14 Volume cubo | 15 Juros simples
16 Desconto | 17 Velocidade media | 18 Consumo medio
19 Par ou impar | 20 IMC | 0 Sair
Escolha uma opcao:&quot;" newline="True"/><input variable="op"/><while expression="op != 0"><body><if expression="op == 1"><then><input variable="a"/><input variable="b"/><assign variable="resultado" expression="a + b"/><output expression="&quot;Resultado da soma:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 2"><then><input variable="a"/><input variable="b"/><assign variable="resultado" expression="a - b"/><output expression="&quot;Resultado da subtracao:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 3"><then><input variable="a"/><input variable="b"/><assign variable="resultado" expression="a * b"/><output expression="&quot;Resultado da multiplicacao:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 4"><then><input variable="a"/><input variable="b"/><if expression="b != 0"><then><assign variable="resultado" expression="a / b"/><output expression="&quot;Resultado da divisao:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><output expression="&quot;Erro: nao e possivel dividir por zero.&quot;" newline="True"/></else></if></then><else><if expression="op == 5"><then><input variable="a"/><input variable="b"/><assign variable="resultado" expression="(a + b) / 2"/><output expression="&quot;Media aritmetica:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 6"><then><input variable="a"/><input variable="percentual"/><assign variable="resultado" expression="a * percentual / 100"/><output expression="&quot;Valor percentual:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 7"><then><input variable="a"/><input variable="b"/><input variable="c"/><if expression="a != 0"><then><assign variable="x" expression="b * c / a"/><output expression="&quot;Resultado da regra de tres:&quot;" newline="True"/><output expression="x" newline="True"/></then><else><output expression="&quot;Erro: o primeiro valor nao pode ser zero.&quot;" newline="True"/></else></if></then><else><if expression="op == 8"><then><input variable="temperatura"/><assign variable="f" expression="temperatura * 9 / 5 + 32"/><output expression="&quot;Temperatura em Fahrenheit:&quot;" newline="True"/><output expression="f" newline="True"/></then><else><if expression="op == 9"><then><input variable="temperatura"/><assign variable="resultado" expression="(temperatura - 32) * 5 / 9"/><output expression="&quot;Temperatura em Celsius:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 10"><then><input variable="base"/><input variable="altura"/><assign variable="resultado" expression="2 * (base + altura)"/><output expression="&quot;Perimetro do retangulo:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 11"><then><input variable="base"/><input variable="altura"/><assign variable="resultado" expression="base * altura"/><output expression="&quot;Area do retangulo:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 12"><then><input variable="base"/><input variable="altura"/><assign variable="resultado" expression="base * altura / 2"/><output expression="&quot;Area do triangulo:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 13"><then><input variable="raio"/><assign variable="resultado" expression="3.141592653589793 * raio * raio"/><output expression="&quot;Area do circulo:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 14"><then><input variable="aresta"/><assign variable="resultado" expression="aresta * aresta * aresta"/><output expression="&quot;Volume do cubo:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 15"><then><input variable="capital"/><input variable="taxa"/><input variable="tempo"/><assign variable="resultado" expression="capital * taxa * tempo / 100"/><output expression="&quot;Juros simples:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 16"><then><input variable="preco"/><input variable="percentual"/><assign variable="resultado" expression="preco * percentual / 100"/><output expression="&quot;Valor do desconto:&quot;" newline="True"/><output expression="resultado" newline="True"/><assign variable="resultado" expression="preco - resultado"/><output expression="&quot;Preco final com desconto:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><if expression="op == 17"><then><input variable="distancia"/><input variable="tempo"/><if expression="tempo &gt; 0"><then><assign variable="resultado" expression="distancia / tempo"/><output expression="&quot;Velocidade media:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><output expression="&quot;Erro: o tempo deve ser maior que zero.&quot;" newline="True"/></else></if></then><else><if expression="op == 18"><then><input variable="distancia"/><input variable="litros"/><if expression="litros &gt; 0"><then><assign variable="resultado" expression="distancia / litros"/><output expression="&quot;Consumo medio em km/L:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><output expression="&quot;Erro: litros deve ser maior que zero.&quot;" newline="True"/></else></if></then><else><if expression="op == 19"><then><input variable="n"/><if expression="n % 2 == 0"><then><output expression="&quot;O numero e par.&quot;" newline="True"/></then><else><output expression="&quot;O numero e impar.&quot;" newline="True"/></else></if></then><else><if expression="op == 20"><then><input variable="peso"/><input variable="altura"/><if expression="altura &gt; 0"><then><assign variable="resultado" expression="peso / (altura * altura)"/><output expression="&quot;IMC:&quot;" newline="True"/><output expression="resultado" newline="True"/></then><else><output expression="&quot;Erro: a altura deve ser maior que zero.&quot;" newline="True"/></else></if></then><else><output expression="&quot;Opcao invalida. Escolha de 0 a 20.&quot;" newline="True"/></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if></else></if><output expression="&quot;===== CALCULADORA - 20 OPERACOES =====
1 Soma | 2 Subtracao | 3 Multiplicacao | 4 Divisao
5 Media | 6 Porcentagem | 7 Regra de tres
8 Celsius para Fahrenheit | 9 Fahrenheit para Celsius
10 Perimetro retangulo | 11 Area retangulo | 12 Area triangulo
13 Area circulo | 14 Volume cubo | 15 Juros simples
16 Desconto | 17 Velocidade media | 18 Consumo medio
19 Par ou impar | 20 IMC | 0 Sair
Escolha uma opcao:&quot;" newline="True"/><input variable="op"/></body></while><output expression="&quot;Calculadora encerrada. Ate logo!&quot;" newline="True"/></body>
  </function>
</flowgorithm>
